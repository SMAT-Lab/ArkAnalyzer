{
  "supportFileExts": [
    ".ets",
    ".ts",
    ".js",
    ".d.ets",
    ".d.ts",
    ".c",
    ".cc",
    ".cpp",
    ".cxx",
    ".h",
    ".hh",
    ".hpp"
  ],
  "enableLeadingComments": false,
  "enableBuiltIn": true,
  "ignoreFileNames": [
    "oh_modules",
    "node_modules",
    "build-tools",
    "hvigorfile.ts",
    "hvigorfile.js",
    "hvigor-wrapper.js",
    "build-tools",
    "build",
    ".cxx",
    ".test",
    ".preview"
  ],
  "sdkGlobalFolders": [
    "component",
    "@internal"
  ],
  "tsconfig": "tsconfig.json"
}