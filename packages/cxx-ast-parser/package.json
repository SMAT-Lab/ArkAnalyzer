{
  "name": "@arkanalyzer/cxx-ast-parser",
  "private": true,
  "version": "1.0.90",
  "description": "Optional C++ AST native runtime for arkanalyzer (not a standalone public SDK)",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "dumper"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.model.json && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "flatbuffers": "^25.2.10"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^5.9.3"
  }
}
