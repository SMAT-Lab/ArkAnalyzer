// FlatBuffers wire schema for C++ AST flat payloads (.ast.flat).
// Pipeline: Clang AST -> astNodeAttrsExtract (JSON attrs) -> astAttrsToWire -> tables below.
// JSON keys are camelCase at the emit/decode boundary; wire fields use snake_case.
// Aligned with ArkCxxAstNode.ts on the TypeScript decode side.
// Wire v13: string fields are uint32 indices into CxxAstPayload.string_pool (0 = absent).

namespace ArkCxxAstFb;

table CxxPositionWire {
  line:int32;
  col:int32;
  offset:uint32;
  tok_len:uint32;
}

table CxxRangeWire {
  begin:CxxPositionWire;
  end:CxxPositionWire;
}

table CxxTypeInfoWire {
  qual_type:uint32;
  desugared_qual_type:uint32;
  type_alias_decl_id:uint64;
}

table CxxReferencedDeclWire {
  kind:uint16;
  name:uint32;
  type:CxxTypeInfoWire;
}

table CxxCtorAnyInitWire {
  name:uint32;
  type:CxxTypeInfoWire;
}

table CxxIncludeInfoWire {
  file_name:uint32;
  include_name:uint32;
  kind:uint16;
  loc:CxxPositionWire;
}

table CxxLocWire {
  file:uint32;
  line:int32;
  col:int32;
}

table ClassBaseWire {
  access:uint8;
  type:CxxTypeInfoWire;
  /// ClassBase attribute bits (virtual inheritance, etc.).
  base_flags:uint8;
}

/// Per-node attrs as structured columns (inner/header_units are separate wire vectors).
table CxxAstNodeWire {
  id:uint32;
  original_id:uint32;
  kind:uint16;
  /// AST shape flags (hasInClassInitializer, isImplicit, isPostfix, isArrow, isArray).
  node_flags:uint8;
  name:uint32;
  /// C++ modifier bitmask; bit layout matches ModifierType in ArkBaseModel.ts.
  modifier_flags:uint32;
  type:CxxTypeInfoWire;
  mangled_name:uint32;
  tag_used:uint8;
  storage_class:uint8;
  access:uint8;
  referenced_decl:CxxReferencedDeclWire;
  value:uint32;
  value_category:uint8;
  cast_kind:uint16;
  opcode:uint8;
  op:uint8;
  type_arg:CxxTypeInfoWire;
  any_init:CxxCtorAnyInitWire;
  base_init:CxxTypeInfoWire;
  nominated_namespace:uint32;
  loc:CxxLocWire;
  range:CxxRangeWire;
  default_arg:CxxTypeInfoWire;
  dtor:uint16;

  includes:[CxxIncludeInfoWire];
  bases:[ClassBaseWire];

  inner:[CxxAstNodeWire];
  header_units:[CxxAstNodeWire];
}

table CxxAstPayload {
  wire_version:uint;
  string_pool:[string];
  root:CxxAstNodeWire;
}

root_type CxxAstPayload;
