FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Use Aliyun mirror for Ubuntu APT
RUN sed -i 's|http://archive.ubuntu.com|http://mirrors.aliyun.com|g; s|http://security.ubuntu.com|http://mirrors.aliyun.com|g' /etc/apt/sources.list

# Layer 1: base system packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    gnupg \
    unzip \
    vim \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

# Layer 2: LLVM/Clang 19 toolchain (TUNA mirror for packages, official for key)
RUN curl -fsSL https://apt.llvm.org/llvm-snapshot.gpg.key \
    | gpg --dearmor -o /usr/share/keyrings/llvm-archive-keyring.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/llvm-archive-keyring.gpg] https://mirrors.tuna.tsinghua.edu.cn/llvm-apt/jammy/ llvm-toolchain-jammy-19 main" \
    > /etc/apt/sources.list.d/llvm.list \
    && apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    python3 \
    python3-pip \
    llvm-19-dev \
    libclang-19-dev \
    clang-19 \
    lld-19 \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Layer 3: Node.js 20 LTS (binary from npmmirror)
RUN curl -fsSL https://npmmirror.com/mirrors/node/v20.19.2/node-v20.19.2-linux-x64.tar.xz \
    | tar -xJ -C /usr/local --strip-components=1

# OpenHarmony SDK home (override with -e at run time if needed)
ENV OHOS_SDK_HOME=/workspace/command-line-tools/sdk/default

WORKDIR /workspace/arkanalyzer

# Layer 4: npm dependencies (cached to /opt, restored at entrypoint if host mount
#          shadows node_modules with incompatible platform binaries)
COPY package.json package-lock.json ./
RUN npm config set registry https://registry.npmmirror.com \
    && npm install \
    && cp -a node_modules /opt/arkanalyzer-deps

# Source code is mounted at runtime: -v $(pwd):/workspace/arkanalyzer
CMD ["/bin/bash"]
