{
  "name": "arkanalyzer",
  "version": "1.0.86",
  "files": [
    "docs",
    "lib",
    "config"
  ],
  "main": "lib/index.js",
  "scripts": {
    "prebuild": "node script/npmInstall.js",
    "build": "tsc",
    "build:cpp": "node script/buildCpp.js",
    "prepack": "npm run build && tsc -p ./tsconfig.prod.json && node script/vendorOhosTypescript.js && copyfiles -f arkCppAst/* lib/ast",
    "test": "npm run build && vitest",
    "testonce": "npm run build && vitest --no-color run",
    "coverage": "npm run build && vitest run --coverage",
    "heapdump": "npm run build && node --expose-gc out/tests/HeapDumpTest.js",
    "gendoc": "npm run build && npx typedoc"
  },
  "dependencies": {
    "commander": "13.1.0",
    "log4js": "6.9.1"
  },
  "devDependencies": {
    "copyfiles": "^2.4.1",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^1.5.0",
    "ohos-typescript": "^4.9.5-r4",
    "ts-node": "^10.9.1",
    "typedoc": "^0.28.0",
    "typedoc-plugin-markdown": "^4.6.3",
    "vitest": "^1.5.0"
  }
}
